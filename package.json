{
  "name": "sistema-granja-porcina",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema Integral de Gestión para Granja Porcina",
  "workspaces": [
    "frontend"
  ],
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.3",
    "@rollup/rollup-win32-x64-msvc": "^4.63.3"
  },
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "dotnet run --project backend/src/Api/Api.csproj",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "dotnet build backend/SistemaGranja.sln",
    "test:backend": "dotnet test backend/SistemaGranja.sln"
  }
}

